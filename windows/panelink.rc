// Icon + version info for panelink.exe (Explorer, Task Manager, Services).
#include <winver.h>
1 ICON "panelink.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION 1,1,0,0
PRODUCTVERSION 1,1,0,0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName", "Mert Suntur"
      VALUE "FileDescription", "PaneLink - Mac display extension (agent + viewer)"
      VALUE "FileVersion", "1.1.0"
      VALUE "InternalName", "panelink"
      VALUE "OriginalFilename", "panelink.exe"
      VALUE "ProductName", "PaneLink"
      VALUE "ProductVersion", "1.1.0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
